    jalankan("UPDATE pengguna SET target_harian = %s WHERE id_pengguna = %s",
             (target_baru, id_pengguna))
    print("Target minum berhasil diubah menjadi", target_baru, "ml.")

def riwayat_minum_hari_ini(id_pengguna):
