import os
import psycopg2
import psycopg2.extras
from datetime import datetime, date

# ---------- VARIABEL TETAP (KONSTANTA) ----------
BATAS_AIR = 3000                # maksimal air per hari (ml)
TARGET_AWAL = 2000              # target awal minum per hari (ml)
MIN_SANDI = 3                   # panjang minimal kata sandi
MAKS_SANDI = 6                  # panjang maksimal kata sandi
MAKS_TIDUR = 6 * 60             # durasi tidur maksimal yang dicatat (menit)
BATAS_KURANG_TIDUR = 5 * 60     # di bawah ini = kurang tidur (menit)

# ---------- VARIABEL GLOBAL ----------
db = None               # koneksi ke database
pengguna_aktif = None   # dictionary user yang sedang login
ROLE_ORTU = None        # id_role orang tua
ROLE_ANAK = None        # id_role anak

#  BAGIAN 1 : KONEKSI DATABASE & FUNGSI BANTU
def buat_koneksi():
    """Menyambungkan program ke database PostgreSQL."""
    try:
        koneksi = psycopg2.connect(
            host="localhost",
            port=5432,
            user="postgres",          # ganti sesuai user PostgreSQL kamu
            password="vanesya27",         # ganti dengan password PostgreSQL kamu
            dbname="db_sleepyhydrate"
        )
        koneksi.autocommit = True
        return koneksi
    except psycopg2.Error as error:
        print("Gagal terhubung ke database:", error)
        return None

def main():
    global db
    db = buat_koneksi()
    if db is None:
        print("Program berhenti karena database tidak terhubung.")
        return
    inisialisasi_data()
    menu_awal()
    db.close()

def ambil_semua(query, isi=()):
    """Menjalankan SELECT dan mengembalikan semua baris (list of dictionary)."""
    cursor = db.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    cursor.execute(query, isi)
    hasil = cursor.fetchall()
    cursor.close()
    return hasil

def ambil_satu(query, isi=()):
    """Menjalankan SELECT dan mengembalikan satu baris (atau None)."""
    cursor = db.cursor(cursor_factory=psycopg2.extras.RealDictCursor)
    cursor.execute(query, isi)
    hasil = cursor.fetchone()
    cursor.close()
    return hasil

def jalankan(query, isi=()):
    """Menjalankan INSERT / UPDATE / DELETE."""
    cursor = db.cursor()
    cursor.execute(query, isi)
    cursor.close()

def bersihkan_layar():
    """Membersihkan layar terminal."""
    if os.name == "nt":
        os.system("cls")
    else:
        os.system("clear")

def jeda():
    """Menahan layar supaya hasil sempat dibaca."""
    input("\nTekan Enter untuk lanjut...")

def konfirmasi_ya(teks):
    """Konfirmasi: 'ya', 'YA', 'Ya', atau 'yA' semuanya dianggap setuju."""
    jawaban = input(teks).strip().lower()
    return jawaban == "ya"

def id_berikutnya(nama_tabel, nama_kolom):
    """Mencari nomor ID berikutnya (kolom ID tidak auto-increment)."""
    hasil = ambil_satu(
        f"SELECT COALESCE(MAX({nama_kolom}), 0) + 1 AS id_baru FROM {nama_tabel}"
    )
    return hasil["id_baru"]

def minta_angka(teks, minimal, maksimal):
    """Meminta input angka sampai user mengisi dengan benar."""
    while True:
        isi = input(teks)
        if isi.isdigit():
            angka = int(isi)
            if angka >= minimal and angka <= maksimal:
                return angka
            print(f"Angka harus antara {minimal} sampai {maksimal}!")
        else:
            print("Input harus berupa angka!")

def format_durasi(menit):
    """Mengubah menit menjadi tulisan 'x jam y menit'."""
    return f"{menit // 60} jam {menit % 60} menit"

def sandi_valid(sandi):
    """Cek panjang kata sandi (3 sampai 6 karakter, huruf/angka bebas)."""
    if len(sandi) < MIN_SANDI or len(sandi) > MAKS_SANDI:
        print(f"Kata sandi harus {MIN_SANDI} sampai {MAKS_SANDI} karakter!")
        return False
    return True

def status_tidur(menit):
    """Mengembalikan 'KURANG TIDUR' kalau tidur kurang dari batas, atau None kalau cukup."""
    if menit < BATAS_KURANG_TIDUR:
        return "KURANG TIDUR"
    else:
        return None

def username_sudah_ada(username):
    """Cek apakah username sudah dipakai."""
    hasil = ambil_satu("SELECT id_pengguna FROM pengguna WHERE username = %s", (username,))
    return hasil is not None

def nama_sudah_ada(nama):
    """Cek apakah nama pengguna sudah dipakai."""
    hasil = ambil_satu("SELECT id_pengguna FROM pengguna WHERE nama_pengguna = %s", (nama,))
    return hasil is not None

def ambil_pengguna(id_pengguna):
    """Mengambil data pengguna beserta nama rolenya."""
    return ambil_satu(
        "SELECT p.*, r.nama_role FROM pengguna p "
        "JOIN role r ON p.id_role = r.id_role "
        "WHERE p.id_pengguna = %s",
        (id_pengguna,)
    )

def refresh_pengguna():
    """Mengambil ulang data user yang login dari database."""
    global pengguna_aktif
    pengguna_aktif = ambil_pengguna(pengguna_aktif["id_pengguna"])

def hapus_data_pengguna(id_pengguna):
    """Menghapus catatan tidur, catatan minum, lalu akun penggunanya."""
    jalankan("DELETE FROM catatan_tidur WHERE id_pengguna = %s", (id_pengguna,))
    jalankan("DELETE FROM catatan_minum WHERE id_pengguna = %s", (id_pengguna,))
    jalankan("DELETE FROM pengguna WHERE id_pengguna = %s", (id_pengguna,))

def cari_id_role(nama_role):
    """Mencari id_role dari namanya. Kalau belum ada, dibuat dulu."""
    hasil = ambil_satu("SELECT id_role FROM role WHERE nama_role = %s", (nama_role,))
    if hasil is None:
        jalankan("INSERT INTO role (nama_role) VALUES (%s)", (nama_role,))
        hasil = ambil_satu("SELECT id_role FROM role WHERE nama_role = %s", (nama_role,))
    return hasil["id_role"]

def inisialisasi_data():
    """Menambah kolom id_ortu bila belum ada, lalu menyiapkan role orangtua & anak."""
    global ROLE_ORTU, ROLE_ANAK
    jalankan("ALTER TABLE pengguna ADD COLUMN IF NOT EXISTS id_ortu INTEGER")
    ROLE_ORTU = cari_id_role("orangtua")
    ROLE_ANAK = cari_id_role("anak")

