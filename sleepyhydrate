    data = ambil_semua(
        "SELECT * FROM catatan_minum WHERE id_pengguna = %s AND tanggal = %s "
        "ORDER BY waktu_minum",
        (id_pengguna, date.today())
    )
    if len(data) == 0:
        print("Belum ada catatan minum hari ini.")
        return

    print("--- RIWAYAT MINUM HARI INI ---")
    for d in data:
        print(f"{d['waktu_minum']} | {d['jumlah_air']} ml")
  
def total_air_tanggal(id_pengguna, tanggal):
    """Menghitung total air yang diminum pada tanggal tertentu (ml)."""
    hasil = ambil_satu(
        "SELECT COALESCE(SUM(jumlah_air), 0) AS total FROM catatan_minum "
        "WHERE id_pengguna = %s AND tanggal = %s",
        (id_pengguna, tanggal)
    )
    return int(hasil["total"])

def tampilkan_progress(total, target):
    """Menampilkan progress bar dan persentase target minum."""
    persen = total / target * 100
    if persen > 100:
        persen = 100
    jumlah_blok = int(persen / 5)           # 20 blok = 100%
    bar = "#" * jumlah_blok + "-" * (20 - jumlah_blok)
    print(f"[{bar}] {persen:.0f}%  ({total} / {target} ml)")
    if total >= target:
        print("Target hari ini sudah tercapai. Hebat!")

#  BAGIAN 6 : KORELASI KESEHATAN
def korelasi_kesehatan(id_pengguna, nama):
    """Menampilkan hubungan durasi tidur, air minum, dan kebugaran."""
    data = ambil_semua(
        "SELECT t.tanggal, t.durasi_tidur, t.kebugaran, "
        "COALESCE((SELECT SUM(m.jumlah_air) FROM catatan_minum m "
        "          WHERE m.id_pengguna = t.id_pengguna AND m.tanggal = t.tanggal), 0) AS total_air "
        "FROM catatan_tidur t "
        "WHERE t.id_pengguna = %s AND t.kebugaran IS NOT NULL "
        "ORDER BY t.tanggal",
        (id_pengguna,)
    )

    print(f"=== KORELASI KESEHATAN: {nama} ===")
    if len(data) == 0:
        print("Belum ada data lengkap (tidur + kebugaran) untuk dianalisis.")
        return

    # 1. tabel data
    print("\nTanggal    | Tidur (jam) | Air (ml) | Kondisi")
    print("-----------+-------------+----------+--------")
    for d in data:
        jam = d["durasi_tidur"] / 60
        print(f"{d['tanggal']} | {jam:11.1f} | {int(d['total_air']):8d} | {d['kebugaran']}")

    # 2. grafik sederhana durasi tidur (1 # = 1 jam)
    print("\nGrafik durasi tidur (1 # = 1 jam):")
    for d in data:
        jam = d["durasi_tidur"] / 60
        print(f"{d['tanggal']} | {'#' * round(jam)} {jam:.1f} jam")

    # 3. rata-rata tiap kondisi kebugaran
    print("\nRata-rata berdasarkan kondisi tubuh:")
    rata_tidur = {}
    rata_air = {}
    for kondisi in ("segar", "pusing", "lemas"):
        jumlah = 0
        total_tidur = 0
        total_air = 0
        for d in data:
            if d["kebugaran"] == kondisi:
                jumlah += 1
                total_tidur += d["durasi_tidur"]
                total_air += int(d["total_air"])
        if jumlah > 0:
            rata_tidur[kondisi] = total_tidur / jumlah
            rata_air[kondisi] = total_air / jumlah
            print(f"- {kondisi:6s}: tidur {format_durasi(int(rata_tidur[kondisi]))}, "
                  f"air {rata_air[kondisi]:.0f} ml ({jumlah} hari)")

    # 4. kesimpulan sederhana (hari segar dibandingkan hari tidak segar)
    if "segar" in rata_tidur and len(rata_tidur) > 1:
        total_tidur_lain = 0
        total_air_lain = 0
        for kondisi in rata_tidur:
            if kondisi != "segar":
                total_tidur_lain += rata_tidur[kondisi]
                total_air_lain += rata_air[kondisi]
        banyak_lain = len(rata_tidur) - 1
        tidur_lain = total_tidur_lain / banyak_lain
        air_lain = total_air_lain / banyak_lain

        print("\nKesimpulan:")
        if rata_tidur["segar"] > tidur_lain:
            print("- Saat tubuh segar, tidurnya cenderung lebih lama.")
        else:
            print("- Durasi tidur belum terlihat berpengaruh pada rasa segar.")
        if rata_air["segar"] > air_lain:
            print("- Saat tubuh segar, air yang diminum cenderung lebih banyak.")
        else:
            print("- Jumlah air minum belum terlihat berpengaruh pada rasa segar.")
    else:
        print("\nData belum cukup untuk membandingkan kondisi segar dengan yang lain.")

