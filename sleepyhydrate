def mulai_tidur(id_pengguna):
    """Mencatat waktu mulai tidur."""
    belum_selesai = ambil_satu(
        "SELECT * FROM catatan_tidur WHERE id_pengguna = %s AND waktu_bangun IS NULL",
        (id_pengguna,)
    )
    if belum_selesai is not None:
        print("Kamu masih tercatat tidur. Pilih 'Bangun tidur' dulu!")
        return

    sekarang = datetime.now()
    jalankan(
        "INSERT INTO catatan_tidur (id_tidur, id_pengguna, tanggal, waktu_tidur) "
        "VALUES (%s, %s, %s, %s)",
        (id_berikutnya("catatan_tidur", "id_tidur"), id_pengguna,
         sekarang.date(), sekarang.strftime("%H:%M:%S"))
    )
    print("Waktu mulai tidur dicatat:", sekarang.strftime("%H:%M"))
    print("Selamat tidur!")

def bangun_tidur(id_pengguna):
    """Mencatat waktu bangun. Urutan: durasi -> peringatan kurang tidur -> kondisi tubuh."""
    catatan = ambil_satu(
        "SELECT * FROM catatan_tidur WHERE id_pengguna = %s AND waktu_bangun IS NULL "
        "ORDER BY id_tidur DESC",
        (id_pengguna,)
    )
    if catatan is None:
        print("Belum ada catatan mulai tidur. Pilih 'Mulai tidur' dulu!")
        return

    # gabungkan tanggal + jam mulai tidur menjadi satu waktu lengkap
    waktu_mulai = datetime.combine(catatan["tanggal"], catatan["waktu_tidur"])
    sekarang = datetime.now()
    durasi_menit = int((sekarang - waktu_mulai).total_seconds() // 60)

    # batasi durasi tidur maksimal
    if durasi_menit > MAKS_TIDUR:
        durasi_menit = MAKS_TIDUR
        print(f"Durasi tidur dibatasi maksimal {format_durasi(MAKS_TIDUR)}.")

    # 1. tampilkan durasi tidur
    print("Selamat pagi! Kamu tidur selama", format_durasi(durasi_menit))

    # 2. tampilkan peringatan kurang tidur (kalau tidurnya kurang)
    peringatan = status_tidur(durasi_menit)
    if peringatan is not None:
        print(f"\n!!! {peringatan} !!!")
        print(f"Kamu tidur kurang dari {BATAS_KURANG_TIDUR // 60} jam. "
              "Usahakan tidur lebih cukup malam ini.")

    # 3. baru setelah itu tanya kondisi tubuh
    kebugaran = pilih_kebugaran()

    jalankan(
        "UPDATE catatan_tidur SET waktu_bangun = %s, durasi_tidur = %s, kebugaran = %s "
        "WHERE id_tidur = %s",
        (sekarang.strftime("%H:%M:%S"), durasi_menit, kebugaran, catatan["id_tidur"])
    )
    print("\nKondisi tubuh :", kebugaran)
    print("Catatan tidur berhasil disimpan.")

def pilih_kebugaran():
    """Meminta user memilih kondisi tubuh setelah bangun."""
    while True:
        print("\nBagaimana kondisi tubuhmu sekarang?")
        print("1. Segar")
        print("2. Pusing")
        print("3. Lemas")
        pilihan = input("Pilih (1-3): ")

        match pilihan:
            case "1":
                return "segar"
            case "2":
                return "pusing"
            case "3":
                return "lemas"
            case _:
                print("Pilihan tidak valid!")

def riwayat_tidur(id_pengguna):
    """Menampilkan 7 catatan tidur terakhir."""
    data = ambil_semua(
        "SELECT * FROM catatan_tidur WHERE id_pengguna = %s "
        "ORDER BY id_tidur DESC LIMIT 7",
        (id_pengguna,)
    )
    if len(data) == 0:
        print("Belum ada catatan tidur.")
        return

    print("\n--- RIWAYAT TIDUR (7 terakhir) ---")
    for d in data:
        if d["waktu_bangun"] is None:
            print(f"{d['tanggal']} | tidur {d['waktu_tidur']} | (masih tidur)")
        else:
            baris = (f"{d['tanggal']} | tidur {d['waktu_tidur']} | "
                     f"bangun {d['waktu_bangun']} | "
                     f"{format_durasi(d['durasi_tidur'])} | {d['kebugaran']}")
            peringatan = status_tidur(d["durasi_tidur"])
            if peringatan is not None:
                baris = baris + " | ** " + peringatan + " **"
            print(baris)

