def tambah_minum(id_pengguna):
    """Menambah catatan minum, maksimal 3 liter per hari."""
    total = total_air_tanggal(id_pengguna, date.today())
    sisa = BATAS_AIR - total
    if sisa <= 0:
        print("Batas input air hari ini (3 liter) sudah tercapai!")
        return

    print("Pilih jumlah air yang diminum:")
    print("1. 250 ml (1 gelas)")
    print("2. 500 ml (1 botol kecil)")
    print("3. Isi sendiri")
    pilihan = input("Pilih (1-3): ")

    match pilihan:
        case "1":
            jumlah = 250
        case "2":
            jumlah = 500
        case "3":
            jumlah = minta_angka("Jumlah air (ml): ", 1, BATAS_AIR)
        case _:
            print("Pilihan tidak valid!")
            return

    if jumlah > sisa:
        print(f"Melebihi batas! Kamu hanya bisa menambah maksimal {sisa} ml lagi hari ini.")
        return

    sekarang = datetime.now()
    jalankan(
        "INSERT INTO catatan_minum (id_pengguna, tanggal, jumlah_air, waktu_minum) "
        "VALUES (%s, %s, %s, %s)",
        (id_pengguna, sekarang.date(), jumlah, sekarang.strftime("%H:%M:%S"))
    )
    print(f"Berhasil mencatat {jumlah} ml.")  

def atur_target(id_pengguna):
